{
  "schemaVersion": 1,
  "kind": "cyberriskscape-template",
  "name": "Salesforce Agentforce Service agent 構成（顧客向け＋ForcedLeak 型の経路）",
  "layer": {
    "nodes": [
      {
        "id": "nag_cust",
        "type": "USER",
        "x": 40,
        "y": 280,
        "label": "顧客（Experience Cloud）",
        "userTrustAttribute": "Guest"
      },
      {
        "id": "nag_exturl",
        "type": "EXTERNAL_ENTITY",
        "x": 40,
        "y": 100,
        "label": "外部 URL（画像・リンクの送信先）",
        "description": "エージェントの出力に含まれる外部 URL。Trusted URL の許可リストで制限する対象"
      },
      {
        "id": "nag_webform",
        "type": "USER",
        "x": 40,
        "y": 700,
        "label": "外部の第三者（Web フォーム）",
        "description": "Web フォームから CRM に書き込める外部の人。ForcedLeak 型の経路の起点",
        "userTrustAttribute": "Guest"
      },
      {
        "id": "nag_employee",
        "type": "USER",
        "x": 270,
        "y": 170,
        "label": "社員（営業・サポート）",
        "userTrustAttribute": "Employee"
      },
      {
        "id": "nag_emp",
        "type": "AGENT",
        "x": 460,
        "y": 40,
        "label": "Employee agent（社員向け）",
        "description": "ログインした社員の権限で動く。リードやケースを読んで要約する",
        "agentAttributes": {
          "agency": "Bounded",
          "blastRadius": "Tenant",
          "identityTier": "Cryptographic"
        }
      },
      {
        "id": "nag_gr",
        "type": "GUARDRAIL",
        "x": 650,
        "y": 40,
        "label": "Einstein Trust Layer",
        "description": "プロンプト防御・データマスキング・毒性検知など。Salesforce 側の保護層"
      },
      {
        "id": "nag_llm",
        "type": "LLM",
        "x": 840,
        "y": 40,
        "label": "LLM（推論エンジン／BYOLLM）"
      },
      {
        "id": "nag_svc",
        "type": "AGENT",
        "x": 460,
        "y": 280,
        "label": "Service agent（顧客向け）",
        "description": "専用のエージェントユーザーで動く。顧客の問い合わせに自律的に応答する",
        "agentAttributes": {
          "agency": "Bounded",
          "blastRadius": "Tenant",
          "identityTier": "LabelOnly"
        }
      },
      {
        "id": "nag_act",
        "type": "TOOL",
        "x": 650,
        "y": 360,
        "label": "アクション（Flow／Apex）",
        "description": "エージェントが呼び出すアクション。実行コンテキスト（ユーザー／システム）と with sharing の有無を確認する",
        "agentAttributes": {
          "agency": "Bounded",
          "blastRadius": "Tenant",
          "identityTier": "LabelOnly"
        }
      },
      {
        "id": "nag_crm",
        "type": "CRM",
        "x": 840,
        "y": 520,
        "label": "CRM（リード・ケース・取引先）",
        "description": "外部から書き込める項目（Web-to-Lead の説明欄など）を含む",
        "cloudSanction": "Sanctioned",
        "cloudOwnership": "Company"
      },
      {
        "id": "nag_dc",
        "type": "DB",
        "x": 460,
        "y": 500,
        "label": "Data Cloud（検索拡張）",
        "description": "retriever による検索拡張。取得内容がそのままプロンプトに入る"
      },
      {
        "id": "nag_human",
        "type": "HUMAN_OPERATOR",
