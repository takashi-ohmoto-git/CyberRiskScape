{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "example-secret-scanner",
          "rules": [
            { "id": "generic-api-key", "name": "Generic API key" },
            { "id": "azure-publish-profile", "name": "Deployment publishing credential" }
          ]
        }
      },
      "results": [
        {
          "ruleId": "azure-publish-profile",
          "level": "error",
          "message": { "text": "A publishing credential was found." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "deploy/webapp.pubxml" }, "region": { "startLine": 12 } } }]
        },
        {
          "ruleId": "generic-api-key",
          "level": "warning",
          "message": { "text": "A key-like string was found." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "config/appsettings.Production.json" }, "region": { "startLine": 4 } } }]
        },
        {
          "ruleId": "generic-api-key",
          "level": "warning",
          "message": { "text": "A key-like string was found." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "scripts/ci-deploy.sh" }, "region": { "startLine": 31 } } }]
        }
      ]
    }
  ]
}
