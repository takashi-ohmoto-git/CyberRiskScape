{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "version": "0.76.2",
          "informationUri": "https://example.com/trivy",
          "rules": [
            {
              "id": "CVE-2026-0101",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": { "text": "example-lib: fictitious prototype pollution" },
              "fullDescription": { "text": "fictitious-vuln-body-text" },
              "defaultConfiguration": { "level": "error" },
              "helpUri": "https://example.com/vuln/CVE-2026-0101",
              "properties": { "tags": ["vulnerability", "security", "HIGH"], "precision": "very-high", "security-severity": "7.5" }
            },
            {
              "id": "AVD-EXMPL-0001",
              "name": "Misconfiguration",
              "shortDescription": { "text": "Storage bucket is not encrypted" },
              "fullDescription": { "text": "fictitious-misconfig-body-text" },
              "defaultConfiguration": { "level": "warning" },
              "helpUri": "https://example.com/avd/AVD-EXMPL-0001",
              "properties": { "tags": ["misconfiguration", "security", "MEDIUM"], "precision": "very-high", "security-severity": "5.5" }
            },
            {
              "id": "example-access-key-id",
              "name": "Secret",
              "shortDescription": { "text": "Example access key ID" },
              "fullDescription": { "text": "Example access key ID" },
              "defaultConfiguration": { "level": "error" },
              "helpUri": "https://example.com/secret/example-access-key-id",
              "properties": { "tags": ["secret", "security", "CRITICAL"], "precision": "very-high", "security-severity": "9.5" }
            }
          ]
        }
      },
      "originalUriBaseIds": { "ROOTPATH": { "uri": "file:///" } },
      "results": [
        {
          "ruleId": "CVE-2026-0101",
          "ruleIndex": 0,
          "level": "error",
          "message": { "text": "Package: example-lib\nInstalled Version: 1.2.3\nVulnerability CVE-2026-0101\nSeverity: HIGH\nFixed Version: 1.2.4\nLink: [CVE-2026-0101](https://example.com/vuln/CVE-2026-0101)" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "package-lock.json", "uriBaseId": "ROOTPATH" },
                "region": { "startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 1 }
              },
              "message": { "text": "package-lock.json: example-lib@1.2.3" }
            }
          ]
        },
        {
          "ruleId": "AVD-EXMPL-0001",
          "ruleIndex": 1,
          "level": "warning",
          "message": { "text": "Artifact: infra/main.tf\nType: terraform\nVulnerability AVD-EXMPL-0001\nSeverity: MEDIUM\nMessage: fictitious-misconfig-message-body" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "infra/main.tf", "uriBaseId": "ROOTPATH" },
                "region": { "startLine": 12, "startColumn": 1, "endLine": 15, "endColumn": 1 }
              },
              "message": { "text": "infra/main.tf" }
            }
          ]
        },
        {
          "ruleId": "example-access-key-id",
          "ruleIndex": 2,
          "level": "error",
          "message": { "text": "Artifact: .env.example\nSecret Example access key ID\nSeverity: CRITICAL\nMatch: EXAMPLE_KEY_ID=****************" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": ".env.example", "uriBaseId": "ROOTPATH" },
                "region": { "startLine": 3, "startColumn": 1, "endLine": 3, "endColumn": 1 }
              },
              "message": { "text": ".env.example" }
            }
          ]
        }
      ]
    }
  ]
}
