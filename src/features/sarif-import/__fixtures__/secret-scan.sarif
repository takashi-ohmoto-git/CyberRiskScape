{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "example-secret-scanner",
          "semanticVersion": "1.0.0",
          "rules": [
            { "id": "cloud-access-key", "shortDescription": { "text": "Cloud access key" } },
            { "id": "generic-api-key", "shortDescription": { "text": "Generic API key" } }
          ]
        }
      },
      "results": [
        {
          "message": { "text": "cloud-access-key has detected secret for file config/app.env at commit 1111111111111111." },
          "ruleId": "cloud-access-key",
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "config/app.env" }, "region": { "startLine": 3, "snippet": { "text": "EXAMPLE-SECRET-VALUE-0001" } } } }
          ],
          "partialFingerprints": {
            "commitSha": "1111111111111111",
            "email": "dev@example.com",
            "author": "Example Developer",
            "date": "2026-11-01",
            "commitMessage": "add config"
          },
          "properties": { "tags": [] }
        },
        {
          "message": { "text": "generic-api-key has detected secret for file web/app.js at commit 1111111111111111." },
          "ruleId": "generic-api-key",
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "web/app.js" }, "region": { "startLine": 42, "snippet": { "text": "EXAMPLE-SECRET-VALUE-0002" } } } }
          ],
          "partialFingerprints": {
            "commitSha": "1111111111111111",
            "email": "dev@example.com",
            "author": "Example Developer",
            "date": "2026-11-01",
            "commitMessage": "add config"
          },
          "properties": { "tags": [] }
        }
      ]
    }
  ]
}
